# Base URL of the application (http://localhost:3000 in dev, https://your-domain.vercel.app in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AniList OAuth Credentials (from https://anilist.co/settings/developer)
NEXT_PUBLIC_ANILIST_CLIENT_ID=52733
ANILIST_CLIENT_SECRET=your_client_secret_here
